# TaskPilot AI 示例配置文件。

复制为 .env 并填写真实值。真实 .env 不会被提交到 Git。

TASKPILOT_LLM_BASE_URL=http://localhost:1234/v1
TASKPILOT_LLM_API_KEY=sk-xxxx
TASKPILOT_LLM_MODEL=deepseek-chat
TASKPILOT_LLM_TIMEOUT=30

# 演示目录：工具只能读取该目录及其子目录
TASKPILOT_DEMO_PROJECT_ROOT=./demo_projects

# 运行时数据库
TASKPILOT_DB_PATH=./taskpilot.db

# 安全限制
TASKPILOT_MAX_INPUT_LENGTH=2000
TASKPILOT_MAX_FILE_SIZE=204800
TASKPILOT_MAX_OUTPUT_SIZE=204800
TASKPILOT_MAX_RUN_TIMEOUT=120
TASKPILOT_MAX_STEPS=10
